<!--
  Pause card on the panel stand: Resume, Place again, About.
-->
<style>
  .card {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 34px;
    width: 1000px;
    height: 620px;
    border-radius: 8px;
    background-color: #f3f1ed;
  }
  .title {
    font-size: 72px;
    font-weight: 800;
    color: #1d1c1a;
  }
  .primary {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 18px;
    width: 420px;
    height: 104px;
    border-radius: 6px;
    background-color: #1d1c1a;
    cursor: pointer;
  }
  .primary:hover {
    background-color: #45423e;
  }
  .primary-icon {
    width: 40px;
    height: 40px;
    color: #f3f1ed;
  }
  .primary-label {
    font-size: 42px;
    font-weight: 700;
    color: #f3f1ed;
  }
  .row {
    flex-direction: row;
    gap: 20px;
  }
  .secondary {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 300px;
    height: 96px;
    border-radius: 6px;
    background-color: #e4e2dd;
    cursor: pointer;
  }
  .secondary:hover {
    background-color: #cac7c2;
  }
  .secondary-icon {
    width: 38px;
    height: 38px;
    color: #1d1c1a;
  }
  .secondary-label {
    font-size: 34px;
    font-weight: 700;
    color: #1d1c1a;
  }
</style>
<div class="card">
  <span class="title">Paused</span>
  <div id="btn-resume" class="primary">
    <Play class="primary-icon"></Play>
    <span class="primary-label">Resume</span>
  </div>
  <div class="row">
    <div id="btn-place" class="secondary">
      <Move class="secondary-icon"></Move>
      <span class="secondary-label">Place again</span>
    </div>
    <div id="btn-day0" class="secondary">
      <GraduationCap class="secondary-icon"></GraduationCap>
      <span id="day0-label" class="secondary-label">Day 0</span>
    </div>
    <div id="btn-about" class="secondary">
      <Info class="secondary-icon"></Info>
      <span class="secondary-label">About</span>
    </div>
  </div>
</div>
