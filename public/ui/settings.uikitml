<!--
  Settings card on the panel stand (opened from the pause card): access options as toggles,
  board size, height and turn as steppers, Day 0 and Close. States set from src/ui/settings.ts.
-->
<style>
  .card {
    flex-direction: column;
    gap: 18px;
    width: 1360px;
    height: 1200px;
    padding-top: 36px;
    padding-bottom: 36px;
    padding-left: 44px;
    padding-right: 44px;
    border-radius: 8px;
    background-color: #f3f1ed;
  }
  .title {
    font-size: 48px;
    font-weight: 800;
    color: #1d1c1a;
  }
  .row {
    flex-direction: row;
    gap: 18px;
  }
  .toggle {
    flex-direction: row;
    align-items: center;
    gap: 18px;
    width: 627px;
    height: 104px;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 8px;
    background-color: #e4e2dd;
    cursor: pointer;
  }
  .toggle:hover {
    background-color: #cac7c2;
  }
  .t-icon {
    width: 44px;
    height: 44px;
    color: #1d1c1a;
  }
  .t-label {
    flex-grow: 1;
    font-size: 38px;
    font-weight: 700;
    color: #1d1c1a;
  }
  .t-state {
    width: 90px;
    font-size: 34px;
    font-weight: 800;
    text-align: right;
    color: #5d5a56;
  }
  .stepper {
    flex-direction: row;
    align-items: center;
    gap: 18px;
    height: 96px;
  }
  .s-label {
    width: 420px;
    font-size: 38px;
    font-weight: 700;
    color: #1d1c1a;
  }
  .s-btn {
    align-items: center;
    justify-content: center;
    width: 120px;
    height: 88px;
    border-radius: 8px;
    background-color: #e4e2dd;
    cursor: pointer;
  }
  .s-btn:hover {
    background-color: #cac7c2;
  }
  .s-icon {
    width: 44px;
    height: 44px;
    color: #1d1c1a;
  }
  .s-value {
    width: 200px;
    font-size: 38px;
    font-weight: 800;
    text-align: center;
    color: #1d1c1a;
  }
  .actions {
    flex-direction: row;
    justify-content: flex-end;
    gap: 18px;
    margin-top: 6px;
  }
  .button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 300px;
    height: 96px;
    border-radius: 6px;
    background-color: #e4e2dd;
    cursor: pointer;
  }
  .button:hover {
    background-color: #cac7c2;
  }
  .button-dark {
    background-color: #1d1c1a;
  }
  .button-dark:hover {
    background-color: #45423e;
  }
  .b-icon {
    width: 38px;
    height: 38px;
    color: #1d1c1a;
  }
  .b-icon-dark {
    color: #f3f1ed;
  }
  .b-label {
    width: 160px;
    font-size: 38px;
    font-weight: 700;
    color: #1d1c1a;
  }
  .b-label-dark {
    color: #f3f1ed;
  }
</style>
<div class="card">
  <span id="settings-title" class="title">Settings</span>
    <div class="row">
      <div id="set-high-contrast" class="toggle">
        <Contrast id="set-high-contrast-icon" class="t-icon"></Contrast>
        <span id="set-high-contrast-label" class="t-label">High contrast</span>
        <span id="set-high-contrast-state" class="t-state">Off</span>
      </div>
      <div id="set-one-hand" class="toggle">
        <Hand id="set-one-hand-icon" class="t-icon"></Hand>
        <span id="set-one-hand-label" class="t-label">One hand</span>
        <span id="set-one-hand-state" class="t-state">Off</span>
      </div>
    </div>
    <div class="row">
      <div id="set-glasses-view" class="toggle">
        <Glasses id="set-glasses-view-icon" class="t-icon"></Glasses>
        <span id="set-glasses-view-label" class="t-label">Glasses view</span>
        <span id="set-glasses-view-state" class="t-state">Off</span>
      </div>
      <div id="set-slower-fire" class="toggle">
        <Turtle id="set-slower-fire-icon" class="t-icon"></Turtle>
        <span id="set-slower-fire-label" class="t-label">Slower fire</span>
        <span id="set-slower-fire-state" class="t-state">Off</span>
      </div>
    </div>
    <div class="row">
      <div id="set-sound" class="toggle">
        <Volume2 id="set-sound-icon" class="t-icon"></Volume2>
        <span id="set-sound-label" class="t-label">Sound</span>
        <span id="set-sound-state" class="t-state">Off</span>
      </div>
      <div id="set-captions" class="toggle">
        <Captions id="set-captions-icon" class="t-icon"></Captions>
        <span id="set-captions-label" class="t-label">Captions</span>
        <span id="set-captions-state" class="t-state">Off</span>
      </div>
    </div>
    <div class="row">
      <div id="set-dwell-select" class="toggle">
        <Timer id="set-dwell-select-icon" class="t-icon"></Timer>
        <span id="set-dwell-select-label" class="t-label">Dwell select</span>
        <span id="set-dwell-select-state" class="t-state">Off</span>
      </div>
      <div id="set-head-pointer" class="toggle">
        <Crosshair id="set-head-pointer-icon" class="t-icon"></Crosshair>
        <span id="set-head-pointer-label" class="t-label">Head pointer</span>
        <span id="set-head-pointer-state" class="t-state">Off</span>
      </div>
    </div>
    <div class="stepper">
      <span id="step-size-label" class="s-label">Board size</span>
      <div id="step-size-down" class="s-btn"><Minus class="s-icon"></Minus></div>
      <span id="step-size-value" class="s-value">56 cm</span>
      <div id="step-size-up" class="s-btn"><Plus class="s-icon"></Plus></div>
    </div>
    <div class="stepper">
      <span id="step-height-label" class="s-label">Board height</span>
      <div id="step-height-down" class="s-btn"><ArrowDown class="s-icon"></ArrowDown></div>
      <span id="step-height-value" class="s-value">0 cm</span>
      <div id="step-height-up" class="s-btn"><ArrowUp class="s-icon"></ArrowUp></div>
    </div>
    <div class="stepper">
      <span id="step-turn-label" class="s-label">Turn</span>
      <div id="step-turn-down" class="s-btn"><RotateCcw class="s-icon"></RotateCcw></div>
      <span id="step-turn-value" class="s-value"></span>
      <div id="step-turn-up" class="s-btn"><RotateCw class="s-icon"></RotateCw></div>
    </div>
  <div class="actions">
    <div id="set-day0" class="button">
      <GraduationCap class="b-icon"></GraduationCap>
      <span id="set-day0-label" class="b-label">Day 0</span>
    </div>
    <div id="set-close" class="button button-dark">
      <Check class="b-icon b-icon-dark"></Check>
      <span id="set-close-label" class="b-label b-label-dark">Close</span>
    </div>
  </div>
</div>
