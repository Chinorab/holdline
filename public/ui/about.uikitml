<!--
  About card: what the fire model is, and where real fire safety advice comes from.
-->
<style>
  .card {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 26px;
    width: 1000px;
    height: 620px;
    padding-left: 72px;
    padding-right: 72px;
    border-radius: 8px;
    background-color: #f3f1ed;
  }
  .title {
    font-size: 64px;
    font-weight: 800;
    color: #1d1c1a;
  }
  .line {
    font-size: 42px;
    font-weight: 600;
    color: #1d1c1a;
    text-align: center;
  }
  .close {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 12px;
    width: 300px;
    height: 96px;
    border-radius: 6px;
    background-color: #1d1c1a;
    cursor: pointer;
  }
  .close:hover {
    background-color: #45423e;
  }
  .close-icon {
    width: 38px;
    height: 38px;
    color: #f3f1ed;
  }
  .close-label {
    font-size: 40px;
    font-weight: 700;
    color: #f3f1ed;
  }
</style>
<div class="card">
  <span class="title">About</span>
  <span id="about-model" class="line">Simplified model, not a forecast.</span>
  <span id="about-safety" class="line">For real fire safety, follow your local authorities.</span>
  <div id="btn-close" class="close">
    <X class="close-icon"></X>
    <span class="close-label">Close</span>
  </div>
</div>
