<!--
  Briefing card on the panel stand at the board's far edge (design canvas: Panel briefing).
  Day, goal, the six houses, wind dial and strength, Start. Texts set from src/copy.ts.
-->
<style>
  .card {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 1200px;
    height: 750px;
    padding-top: 40px;
    padding-bottom: 40px;
    padding-left: 64px;
    padding-right: 64px;
    border-radius: 8px;
    background-color: #f3f1ed;
  }
  .day {
    margin-bottom: 14px;
    font-size: 38px;
    font-weight: 700;
    color: #5d5a56;
  }
  .goal {
    font-size: 68px;
    font-weight: 800;
    color: #1d1c1a;
  }
  .houses {
    flex-direction: row;
    gap: 14px;
    margin-top: 24px;
  }
  .house {
    width: 56px;
    height: 56px;
    color: #1d1c1a;
  }
  .wind-row {
    flex-direction: row;
    align-items: center;
    gap: 36px;
    margin-top: 34px;
  }
  .dial {
    width: 168px;
    height: 168px;
    align-items: center;
    justify-content: center;
    border-radius: 84px;
    border-width: 4px;
    border-color: #1d1c1a;
    background-color: #f3f1ed;
  }
  .arrow {
    width: 116px;
    height: 116px;
    color: #1d1c1a;
  }
  .wind-col {
    flex-direction: column;
    gap: 10px;
  }
  .wind-label {
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }
  .flag {
    width: 36px;
    height: 36px;
    color: #5d5a56;
  }
  .label {
    font-size: 38px;
    font-weight: 700;
    color: #5d5a56;
  }
  .wind-word {
    font-size: 64px;
    font-weight: 800;
    color: #1d1c1a;
  }
  .meter {
    flex-direction: row;
    gap: 6px;
    margin-top: 4px;
  }
  .bar {
    width: 44px;
    height: 14px;
    border-width: 2px;
    border-color: #1d1c1a;
    background-color: #f3f1ed;
  }
  .start {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 40px;
    width: 380px;
    height: 104px;
    border-radius: 6px;
    background-color: #1d1c1a;
    cursor: pointer;
  }
  .start:hover {
    background-color: #45423e;
  }
  .start-icon {
    width: 38px;
    height: 38px;
    color: #f3f1ed;
  }
  .start-label {
    font-size: 42px;
    font-weight: 700;
    color: #f3f1ed;
  }
</style>
<div class="card">
  <span id="brief-day" class="day">Day 1</span>
  <span id="brief-goal" class="goal">Protect all 6 houses</span>
  <div class="houses">
    <House class="house"></House>
    <House class="house"></House>
    <House class="house"></House>
    <House class="house"></House>
    <House class="house"></House>
    <House class="house"></House>
  </div>
  <div class="wind-row">
    <div class="dial">
      <ArrowUp id="brief-arrow" class="arrow"></ArrowUp>
    </div>
    <div class="wind-col">
      <div class="wind-label">
        <Flag class="flag"></Flag>
        <span class="label">Wind</span>
      </div>
      <span id="brief-wind" class="wind-word">Light</span>
      <div class="meter">
        <div id="bar-1" class="bar"></div>
        <div id="bar-2" class="bar"></div>
        <div id="bar-3" class="bar"></div>
        <div id="bar-4" class="bar"></div>
      </div>
    </div>
  </div>
  <div id="btn-start" class="start">
    <Play class="start-icon"></Play>
    <span id="start-label" class="start-label">Start</span>
  </div>
</div>
